{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaaaa",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f0577f86-bdac-4a44-aa8f-422dd4480168","database_name": "novaaa" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d3e75f2786a64139956dd7c9aa16f525" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
